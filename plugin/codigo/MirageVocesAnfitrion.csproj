<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compilar: dotnet build -c Release -p:GameDir="RUTA\Lethal Company" -p:ProfileDir="RUTA\TuPerfil"
       (ProfileDir: la carpeta del perfil del mod manager, la que contiene BepInEx). -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>MirageVoces.Anfitrion</AssemblyName>
    <RootNamespace>MirageVoces.Anfitrion</RootNamespace>
    <LangVersion>8.0</LangVersion>
    <Version>1.1.0</Version>
    <Deterministic>true</Deterministic>
    <DebugType>none</DebugType>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GameManaged>$(GameDir)\Lethal Company_Data\Managed</GameManaged>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="BepInEx"><HintPath>$(ProfileDir)\BepInEx\core\BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(GameManaged)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(GameManaged)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="MirageVoces"><HintPath>$(ProfileDir)\BepInEx\plugins\Lloreria-MirageVoces\MirageVoces.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
